# ──────────────────────────────────────────────────────────────────────────────
# 01-secrets.yaml.example — Шаблон для создания реального 01-secrets.yaml
#
# ИСПОЛЬЗОВАНИЕ:
#   1. cp rancher/k8s/01-secrets.yaml.example rancher/k8s/01-secrets.yaml
#   2. Заполнить реальными значениями
#   3. kubectl apply -f rancher/k8s/01-secrets.yaml
#
# ВНИМАНИЕ: реальный 01-secrets.yaml добавлен в .gitignore и не коммитится!
# ──────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: pet-gym-secrets   # Имя Secret — на него ссылается 06-app.yaml через secretKeyRef
  namespace: pet-gym       # Должен быть в том же namespace что и Deployment
type: Opaque               # Тип Opaque = произвольные key-value пары (не JWT, не TLS и т.д.)
stringData:
  # Пароль PostgreSQL — берётся из application.properties (spring.datasource.password=1234)
  # В Deployment передаётся как SPRING_DATASOURCE_PASSWORD через secretKeyRef
  postgres-password: "CHANGE_ME"

  # Alfa Bank Payment Gateway
  # Получить в личном кабинете: https://alfa.rbsuat.com (тестовая) или prod-среда
  # В Deployment передаётся как ALFABANK_USERNAME / ALFABANK_PASSWORD через secretKeyRef
  alfabank-username: "CHANGE_ME"
  alfabank-password: "CHANGE_ME"
